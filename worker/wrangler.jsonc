{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playlistout-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "api.playlistout.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "playlistout-stats",
      "database_id": "playlistout-stats-db-id"
    }
  ]
}

