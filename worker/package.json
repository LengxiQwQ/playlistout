    "test:all": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "^3.111.0"
  }
}
