{
  "name": "playlistout-worker",
  "version": "2.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/",
    "test:d1": "vitest run test/d1-migration-safety.test.ts",
    "test:live": "vitest run test/real-validation.test.ts",
    "test:production:live": "vitest run test/production-api-live.test.ts",
    "test:live:authenticated": "vitest run test/authenticated-kugou-live.test.ts",
    "test:all": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0",
    "vite": "^6.4.3"
  }
}
